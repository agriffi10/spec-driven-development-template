# Generated by scripts/gen-index.sh from the frontmatter under docs/decisions/. Do not edit: run `sh scripts/gen-index.sh`.
areas:
  - name: "API"
    slug: "api"
    path: "docs/decisions/api/api.md"
    governs: ["docs/specs/**", "docs/process/*.md"]
    decisions:
      - title: "Errors are problem+json"
        fence: "Every 4xx/5xx body is `problem+json`: never a \"bare\" string \\ or #text."
        status: "stable"
        path: "docs/decisions/api/errors-are-problem-json.md"
      - title: "No GraphQL layer"
        fence: "REST only; the gateway was removed and is not coming back."
        status: "deprecated"
        path: "docs/decisions/api/no-graphql.md"
  - name: "Area A"
    slug: "area-a"
    path: "docs/decisions/area-a/area-a.md"
    governs: []
    decisions:
      - title: "Label"
        fence: "a fence."
        status: "stable"
        path: "docs/decisions/area-a/label.md"
  - name: "Zeta"
    slug: "zeta"
    path: "docs/decisions/zeta/zeta.md"
